# The homelab zone, generated by the wizard from state.yaml (machines and panels).
${DOMAIN}:53 {
    bind ${WG_IP}
    file /etc/coredns/db.${DOMAIN}
    errors
    log
}

# Everything else: forwarded to the machine's own resolver, for WireGuard clients only.
.:53 {
    bind ${WG_IP}
    forward . /etc/resolv.conf
    cache 300
    loop
    errors
}
